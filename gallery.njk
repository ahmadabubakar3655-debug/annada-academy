---
layout: base.njk
title: Gallery
permalink: /gallery/index.html
---

<div class="container" style="padding: 2rem 0;">
  <h1 style="color: #1B2A4A; text-align: center; margin-bottom: 2rem;">Our Gallery</h1>
  
  <div id="galleryGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
    <p style="grid-column: 1/-1; text-align: center; color: #666;">Loading images...</p>
  </div>
</div>

<script>
  async function loadGallery() {
    try {
      const response = await fetch('/.netlify/functions/get-gallery');
      const data = await response.json();
      
      const grid = document.getElementById('galleryGrid');
      
      if (data.success && data.images.length === 0) {
        grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #666;">No images in gallery yet.</p>';
        return;
      }

      grid.innerHTML = data.images.map(img => `
        <div style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.3s; cursor: pointer;" onclick="openLightbox('${img._id}')">
          <img src="${img.imageData}" alt="${img.title}" style="width: 100%; height: 250px; object-fit: cover;">
          <div style="padding: 15px;">
            <h3 style="margin: 0; color: #1B2A4A;">${img.title}</h3>
            ${img.description ? `<p style="margin: 5px 0; color: #666;">${img.description}</p>` : ''}
            <small style="color: #999;">${img.category || 'general'} • ${new Date(img.createdAt).toLocaleDateString()}</small>
          </div>
        </div>
      `).join('');
    } catch (error) {
      console.error('Error loading gallery:', error);
    }
  }

  function openLightbox(id) {
    // Simple lightbox - you can expand this
    alert('Image view coming soon! ID: ' + id);
  }

  loadGallery();
</script>