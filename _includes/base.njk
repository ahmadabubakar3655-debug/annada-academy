<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Halqatul Qur'anil Karim — Raising sound and moral Qur'anic memorizers and Islamic developers. Sabon Garin Kudan, Kaduna State, Nigeria.">
  <meta name="keywords" content="Qur'an, memorization, Hifz, Islamic, education, Kudan, Kaduna, Nigeria, Halqatul Qur'anil Karim">
  <meta name="author" content="Halqatul Qur'anil Karim">
  
  <!-- Page Title -->
  <title>{% if title %}{{ title }} | {% endif %}Halqatul Qur'anil Karim</title>

  <!-- ================= FAVICON (Logo in browser tab) ================= -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/logo.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/logo.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/logo.png">
  <link rel="shortcut icon" href="/assets/images/logo.png">
  <link rel="mask-icon" href="/assets/images/logo.png" color="#1B2A4A">
  <meta name="msapplication-TileColor" content="#1B2A4A">
  <meta name="theme-color" content="#1B2A4A">

  <!-- ================= SOCIAL MEDIA PREVIEW (WhatsApp, Facebook, etc.) ================= -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Halqatul Qur'anil Karim">
  <meta property="og:description" content="Raising sound and moral Qur'anic memorizers and Islamic developers.">
  <meta property="og:image" content="/assets/images/logo.png">
  <meta property="og:url" content="https://halqatul-quranil-karim.netlify.app/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Halqatul Qur'anil Karim">
  <meta name="twitter:description" content="Raising sound and moral Qur'anic memorizers and Islamic developers.">
  <meta name="twitter:image" content="/assets/images/logo.png">

  <!-- ================= CSS ================= -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- ================= GOOGLE FONTS ================= -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700&family=Merriweather:wght@400;700;900&display=swap" rel="stylesheet">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #333;
      line-height: 1.6;
      background: #FFFFFF;
    }
    h1, h2, h3, h4, h5, h6 {
      font-family: 'Merriweather', Georgia, serif;
    }
    .arabic {
      font-family: 'Amiri', serif;
    }
    a {
      transition: all 0.2s ease;
    }
    img {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>

  <!-- Header -->
  {% include "header.njk" %}

  <!-- Main Content -->
  <main>
    {{ content | safe }}
  </main>

  <!-- Footer -->
  {% include "footer.njk" %}

</body>
</html>