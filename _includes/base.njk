<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.shortName }}</title>
  <meta name="description" content="{{ description or site.tagline }}">

  <!-- Open Graph tags help the page look good when shared on WhatsApp/Facebook -->
  <meta property="og:title" content="{{ title }} | {{ site.shortName }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="/assets/images/logo.png">

  <link rel="icon" href="/assets/images/logo.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {% include "header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <script src="/js/main.js"></script>
</body>
</html>
