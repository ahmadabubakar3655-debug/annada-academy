<header style="background: #1B2A4A; padding: 0.8rem 0; box-shadow: 0 2px 15px rgba(0,0,0,0.15); position: sticky; top: 0; z-index: 1000;">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- Logo -->
    <a href="/" style="display: flex; align-items: center; text-decoration: none; gap: 12px;">
      <img src="/assets/images/logo.png" alt="Annada Academy" style="height: 45px; width: auto;">
      <div>
        <div style="color: #C9A24B; font-weight: 700; font-size: 1.1rem; line-height: 1.2;">Annada Academy</div>
        <div style="color: #F7F3EC; font-size: 0.65rem; opacity: 0.7;">Qur'an & Science</div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav style="display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;">
      <a href="/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">Home</a>
      <a href="/about/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">About</a>
      <a href="/academics/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">Academics</a>
      <a href="/admissions/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">Admissions</a>
      <a href="/school-life/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">School Life</a>
      <a href="/gallery/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">Gallery</a>
      <a href="/news/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">News</a>
      <a href="/faq/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">FAQ</a>
      <a href="/contact/" style="color: white; text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 4px; transition: background 0.3s;">Contact</a>
      
      <!-- Admin Link (visible when logged in) -->
      <div id="adminLink" style="display: none;">
        <a href="/admin/" style="background: #C9A24B; color: #1B2A4A; text-decoration: none; font-weight: 600; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem;">Admin</a>
      </div>
      
      <!-- Student Login -->
      <a href="/student-login/" style="background: #1E5631; color: white; text-decoration: none; font-weight: 600; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; transition: background 0.3s;">Student</a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button id="menuToggle" style="display: none; background: none; border: none; color: white; font-size: 1.8rem; cursor: pointer; padding: 5px;">
      ☰
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" style="display: none; background: #1B2A4A; padding: 1rem 20px; border-top: 1px solid rgba(255,255,255,0.1);">
    <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
      <a href="/" style="color: white; text-decoration: none; padding: 8px 0;">Home</a>
      <a href="/about/" style="color: white; text-decoration: none; padding: 8px 0;">About</a>
      <a href="/academics/" style="color: white; text-decoration: none; padding: 8px 0;">Academics</a>
      <a href="/admissions/" style="color: white; text-decoration: none; padding: 8px 0;">Admissions</a>
      <a href="/school-life/" style="color: white; text-decoration: none; padding: 8px 0;">School Life</a>
      <a href="/gallery/" style="color: white; text-decoration: none; padding: 8px 0;">Gallery</a>
      <a href="/news/" style="color: white; text-decoration: none; padding: 8px 0;">News</a>
      <a href="/faq/" style="color: white; text-decoration: none; padding: 8px 0;">FAQ</a>
      <a href="/contact/" style="color: white; text-decoration: none; padding: 8px 0;">Contact</a>
      <div id="mobileAdminLink" style="display: none;">
        <a href="/admin/" style="background: #C9A24B; color: #1B2A4A; text-decoration: none; padding: 10px 20px; border-radius: 6px; text-align: center; font-weight: 600; display: block;">Admin</a>
      </div>
      <a href="/student-login/" style="background: #1E5631; color: white; text-decoration: none; padding: 10px 20px; border-radius: 6px; text-align: center; font-weight: 600;">Student Login</a>
    </nav>
  </div>
</header>

<script>
  // Show admin link if logged in
  document.addEventListener('DOMContentLoaded', function() {
    const adminToken = localStorage.getItem('adminToken');
    if (adminToken) {
      document.getElementById('adminLink').style.display = 'inline-block';
      document.getElementById('mobileAdminLink').style.display = 'block';
    }
  });

  // Mobile Menu Toggle
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');

  function handleMenuVisibility() {
    if (window.innerWidth <= 768) {
      menuToggle.style.display = 'block';
      mobileMenu.style.display = 'none';
    } else {
      menuToggle.style.display = 'none';
      mobileMenu.style.display = 'none';
    }
  }

  menuToggle.addEventListener('click', function() {
    mobileMenu.style.display = mobileMenu.style.display === 'none' ? 'block' : 'none';
  });

  window.addEventListener('resize', handleMenuVisibility);
  handleMenuVisibility();
</script>