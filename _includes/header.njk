<header style="background: #1B2A4A; padding: 0.9rem 0; box-shadow: 0 2px 15px rgba(0,0,0,0.15); position: sticky; top: 0; z-index: 1000;">
  <div style="display: flex; justify-content: space-between; align-items: center; max-width: 1300px; margin: 0 auto; padding: 0 1.5rem;">
    
    <!-- Logo -->
    <a href="/" style="display: flex; align-items: center; text-decoration: none; gap: 12px;">
      <img src="/assets/images/logo.png" alt="Annada Academy" style="height: 48px; width: auto;">
      <div style="display: none;" class="logo-text">
        <div style="color: #C9A24B; font-weight: 700; font-size: 1.15rem; line-height: 1.2;">Annada Academy</div>
        <div style="color: #F7F3EC; font-size: 0.65rem; opacity: 0.7;">Qur'an &amp; Science</div>
      </div>
    </a>

    <!-- DESKTOP NAVIGATION (hidden on mobile) -->
    <nav class="desktop-nav" style="display: flex; gap: 0.4rem; align-items: center;">
      <a href="/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">Home</a>
      <a href="/about/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">About</a>
      <a href="/academics/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">Academics</a>
      <a href="/admissions/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">Admissions</a>
      <a href="/gallery/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">Gallery</a>
      <a href="/news/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">News</a>
      <a href="/contact/" style="color: #FFFFFF; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; transition: background 0.2s;">Contact</a>
      
      <!-- Admin Button (shows when logged in) -->
      <a href="/admin/" id="adminLink" style="display: none; background: #C9A24B; color: #1B2A4A; text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; margin-left: 0.5rem; transition: background 0.2s;">
        Admin
      </a>
      
      <!-- Student Login -->
      <a href="/student-login/" style="background: #1E5631; color: #FFFFFF; text-decoration: none; font-weight: 600; padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; margin-left: 0.3rem; transition: background 0.2s;">
        Student Login
      </a>
    </nav>

    <!-- MOBILE HAMBURGER BUTTON (shows on mobile only) -->
    <button id="menuToggle" style="display: none; background: transparent; border: 2px solid rgba(255,255,255,0.3); color: #FFFFFF; font-size: 1.5rem; cursor: pointer; padding: 6px 12px; border-radius: 6px; line-height: 1;">
      ☰
    </button>
  </div>

  <!-- MOBILE MENU (slides down when hamburger clicked) -->
  <div id="mobileMenu" style="display: none; background: #15223c; padding: 1rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
    <nav style="display: flex; flex-direction: column; gap: 0.3rem;">
      <a href="/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">Home</a>
      <a href="/about/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">About</a>
      <a href="/academics/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">Academics</a>
      <a href="/admissions/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">Admissions</a>
      <a href="/school-life/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">School Life</a>
      <a href="/gallery/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">Gallery</a>
      <a href="/news/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">News</a>
      <a href="/faq/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">FAQ</a>
      <a href="/contact/" style="color: #FFFFFF; text-decoration: none; padding: 12px 8px; border-radius: 6px; font-weight: 500; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05);">Contact</a>
      
      <a href="/student-login/" style="background: #1E5631; color: #FFFFFF; text-decoration: none; padding: 14px 20px; border-radius: 6px; text-align: center; font-weight: 600; margin-top: 0.8rem;">
        Student Login
      </a>
      
      <a href="/admin/" id="mobileAdminLink" style="display: none; background: #C9A24B; color: #1B2A4A; text-decoration: none; padding: 14px 20px; border-radius: 6px; text-align: center; font-weight: 700; margin-top: 0.5rem;">
        Admin Dashboard
      </a>
    </nav>
  </div>
</header>

<style>
  /* Show logo text on larger screens */
  @media (min-width: 768px) {
    .logo-text { display: block !important; }
  }

  /* Mobile responsive */
  @media (max-width: 900px) {
    .desktop-nav { display: none !important; }
    #menuToggle { display: block !important; }
  }

  /* Nav hover effects */
  .desktop-nav a:hover {
    background: rgba(255,255,255,0.1);
  }

  /* Mobile menu links hover */
  #mobileMenu a:hover {
    background: rgba(201, 162, 75, 0.15);
  }

  /* Hero responsive */
  @media (max-width: 768px) {
    h1 { font-size: 2rem !important; }
  }
</style>

<script>
  // ============ HAMBURGER MENU TOGGLE ============
  document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', function() {
        if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
          mobileMenu.style.display = 'block';
          menuToggle.textContent = '✕';
        } else {
          mobileMenu.style.display = 'none';
          menuToggle.textContent = '☰';
        }
      });

      // Close menu when clicking a link
      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', function() {
          mobileMenu.style.display = 'none';
          menuToggle.textContent = '☰';
        });
      });
    }

    // ============ SHOW ADMIN BUTTON IF LOGGED IN ============
    const adminToken = localStorage.getItem('adminToken');
    if (adminToken) {
      const adminLink = document.getElementById('adminLink');
      const mobileAdminLink = document.getElementById('mobileAdminLink');
      if (adminLink) adminLink.style.display = 'inline-block';
      if (mobileAdminLink) mobileAdminLink.style.display = 'block';
    }
  });
</script>