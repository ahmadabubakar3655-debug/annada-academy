<script>
  // Warm up MongoDB connection when user visits any page
  // This makes sure the database is ready when they open gallery/news
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    fetch('/.netlify/functions/test-connection').catch(() => {});
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      fetch('/.netlify/functions/test-connection').catch(() => {});
    });
  }
</script>