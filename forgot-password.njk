---
layout: base.njk
title: Forgot Password
permalink: /forgot-password/index.html
---

<div class="container" style="max-width: 450px; margin: 4rem auto; padding: 2rem; background: #F7F3EC; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
  <h1 style="color: #1B2A4A; text-align: center; font-size: 1.8rem; margin-bottom: 0.5rem;">Forgot Password</h1>
  <p style="text-align: center; color: #666; margin-bottom: 2rem;">Enter your email to receive a reset link</p>

  <form id="forgotForm">
    <div style="margin-bottom: 1.5rem;">
      <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #1B2A4A;">Email</label>
      <input type="email" id="email" required style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 1rem;">
    </div>
    <button type="submit" style="width: 100%; padding: 12px; background: #C9A24B; color: white; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer;">
      Send Reset Link
    </button>
  </form>

  <p style="text-align: center; margin-top: 1.5rem;">
    <a href="/student-login/" style="color: #C9A24B; font-weight: 600;">Back to Login</a>
  </p>

  <div id="message" style="margin-top: 1rem; padding: 12px; border-radius: 8px; display: none;"></div>
</div>

<script>
  document.getElementById('forgotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const messageDiv = document.getElementById('message');

    messageDiv.style.display = 'block';
    messageDiv.style.background = '#cce5ff';
    messageDiv.style.color = '#004085';
    messageDiv.textContent = 'Sending reset link...';

    try {
      const response = await fetch('/.netlify/functions/request-reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      const data = await response.json();

      if (data.success) {
        messageDiv.style.background = '#d4edda';
        messageDiv.style.color = '#155724';
        messageDiv.innerHTML = '✅ <strong>Email sent!</strong><br>Please check your inbox (and spam folder) for the password reset link.';
        document.getElementById('email').value = '';
      } else {
        messageDiv.style.background = '#f8d7da';
        messageDiv.style.color = '#721c24';
        messageDiv.innerHTML = '❌ <strong>Error:</strong> ' + (data.error || 'Request failed');
      }
    } catch (error) {
      messageDiv.style.background = '#f8d7da';
      messageDiv.style.color = '#721c24';
      messageDiv.innerHTML = '❌ <strong>Error:</strong> ' + error.message;
    }
  });
</script>