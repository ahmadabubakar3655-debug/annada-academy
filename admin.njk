async function addHifz() {
  const studentId = document.getElementById('hifzStudent').value;
  const surahName = document.getElementById('hifzSurahName').value.trim();
  const surahNumber = document.getElementById('hifzSurahNumber').value;
  const juzNumber = document.getElementById('hifzJuz').value;
  const pages = document.getElementById('hifzPages').value.trim();
  const status = document.getElementById('hifzStatus').value;
  const notes = document.getElementById('hifzNotes').value.trim();
  const statusDiv = document.getElementById('hifzStatus2');

  if (!studentId || !surahName || !surahNumber) {
    statusDiv.style.color = '#dc3545';
    statusDiv.textContent = '❌ Student, Surah name, and Surah number are required';
    return;
  }

  statusDiv.style.color = '#1B2A4A';
  statusDiv.textContent = 'Saving...';

  try {
    const response = await fetch('/.netlify/functions/add-hifz', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + localStorage.getItem('adminToken')
      },
      body: JSON.stringify({ studentId, surahName, surahNumber, juzNumber, pages, status, notes })
    });

    const data = await response.json();

    if (data.success) {
      statusDiv.style.color = '#1E5631';
      statusDiv.textContent = '✅ Record added successfully!';
      document.getElementById('hifzSurahName').value = '';
      document.getElementById('hifzSurahNumber').value = '';
      document.getElementById('hifzJuz').value = '';
      document.getElementById('hifzPages').value = '';
      document.getElementById('hifzNotes').value = '';
      loadHifzList();
    } else {
      statusDiv.style.color = '#dc3545';
      statusDiv.textContent = '❌ Error: ' + data.error;
    }
  } catch (error) {
    statusDiv.style.color = '#dc3545';
    statusDiv.textContent = '❌ Error: ' + error.message;
  }
}

async function loadHifzList() {
  try {
    const response = await fetch('/.netlify/functions/get-hifz');
    const data = await response.json();
    
    const list = document.getElementById('hifzList');
    if (!data.success || data.records.length === 0) {
      list.innerHTML = '<p style="color: #666;">No records yet.</p>';
      return;
    }

    const byStudent = {};
    data.records.forEach(rec => {
      if (!byStudent[rec.studentName]) byStudent[rec.studentName] = [];
      byStudent[rec.studentName].push(rec);
    });

    let html = '';
    for (const [name, records] of Object.entries(byStudent)) {
      html += `
        <div style="background: white; border-radius: 8px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden;">
          <div style="background: #1B2A4A; color: white; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;">
            <strong>${name}</strong>
            <span style="background: #C9A24B; color: #1B2A4A; padding: 3px 10px; border-radius: 12px; font-size: 0.85rem; font-weight: 600;">${records.length} records</span>
          </div>
          <div style="padding: 15px; overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 600px;">
              <thead>
                <tr style="background: #F7F3EC;">
                  <th style="padding: 8px; text-align: left;">Surah</th>
                  <th style="padding: 8px; text-align: left;">#</th>
                  <th style="padding: 8px; text-align: left;">Juz</th>
                  <th style="padding: 8px; text-align: left;">Pages</th>
                  <th style="padding: 8px; text-align: left;">Status</th>
                  <th style="padding: 8px; text-align: left;">Date</th>
                  <th style="padding: 8px; text-align: left;">Action</th>
                </tr>
              </thead>
              <tbody>
                ${records.map(r => `
                  <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 8px;">${r.surahName}</td>
                    <td style="padding: 8px;">${r.surahNumber}</td>
                    <td style="padding: 8px;">${r.juzNumber || '-'}</td>
                    <td style="padding: 8px;">${r.pages || '-'}</td>
                    <td style="padding: 8px;">${r.status === 'memorized' ? '✅' : r.status === 'revising' ? '🔄' : '📖'} ${r.status}</td>
                    <td style="padding: 8px;">${new Date(r.createdAt).toLocaleDateString()}</td>
                    <td style="padding: 8px;">
                      <button onclick="deleteHifz('${r._id}')" style="background: #dc3545; color: white; padding: 4px 10px; border: none; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Delete</button>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    list.innerHTML = html;
  } catch (error) {
    console.error('Error loading hifz:', error);
  }
}

async function deleteHifz(id) {
  if (!confirm('Delete this record?')) return;
  const response = await fetch('/.netlify/functions/delete-hifz', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + localStorage.getItem('adminToken')
    },
    body: JSON.stringify({ id })
  });
  const data = await response.json();
  if (data.success) {
    loadHifzList();
  }
}

// ===================== ATTENDANCE =====================
let attendanceStudents = [];

async function loadAttendanceForm() {
  const dateInput = document.getElementById('attendanceDate');
  if (!dateInput.value) {
    dateInput.value = new Date().toISOString().split('T')[0];
  }

  try {
    const studentsRes = await fetch('/.netlify/functions/get-students', {
      headers: { 'Authorization': 'Bearer ' + localStorage.getItem('adminToken') }
    });
    const studentsData = await studentsRes.json();
    attendanceStudents = studentsData.students || [];

    const date = dateInput.value;
    const attRes = await fetch('/.netlify/functions/get-attendance?date=' + date);
    const attData = await attRes.json();
    const existing = {};
    (attData.records || []).forEach(r => {
      existing[r.studentId] = { status: r.status, notes: r.notes };
    });

    const container = document.getElementById('attendanceTable');
    if (attendanceStudents.length === 0) {
      container.innerHTML = '<p style="color: #666;">No students registered yet.</p>';
      return;
    }

    container.innerHTML = `
      <table style="width: 100%; border-collapse: collapse; min-width: 700px;">
        <thead style="background: #1B2A4A; color: white;">
          <tr>
            <th style="padding: 10px; text-align: left;">Student</th>
            <th style="padding: 10px; text-align: left;">Grade</th>
            <th style="padding: 10px; text-align: center;">Present</th>
            <th style="padding: 10px; text-align: center;">Absent</th>
            <th style="padding: 10px; text-align: center;">Late</th>
            <th style="padding: 10px; text-align: left;">Notes</th>
          </tr>
        </thead>
        <tbody>
          ${attendanceStudents.map(s => {
            const existingStatus = existing[s._id]?.status || '';
            const existingNotes = existing[s._id]?.notes || '';
            return `
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;">${s.name}</td>
                <td style="padding: 10px;">${s.grade || 'N/A'}</td>
                <td style="padding: 10px; text-align: center;">
                  <input type="radio" name="att_${s._id}" value="present" ${existingStatus === 'present' ? 'checked' : ''}>
                </td>
                <td style="padding: 10px; text-align: center;">
                  <input type="radio" name="att_${s._id}" value="absent" ${existingStatus === 'absent' ? 'checked' : ''}>
                </td>
                <td style="padding: 10px; text-align: center;">
                  <input type="radio" name="att_${s._id}" value="late" ${existingStatus === 'late' ? 'checked' : ''}>
                </td>
                <td style="padding: 10px;">
                  <input type="text" id="notes_${s._id}" value="${existingNotes}" placeholder="Optional" style="width: 100%; padding: 6px; border: 1px solid #ddd; border-radius: 4px;">
                </td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    `;

    loadAttendanceHistory();
  } catch (error) {
    console.error('Error loading attendance form:', error);
  }
}

async function markAttendance() {
  const date = document.getElementById('attendanceDate').value;
  const statusDiv = document.getElementById('attendanceStatus');

  if (!date) {
    statusDiv.style.color = '#dc3545';
    statusDiv.textContent = '❌ Please select a date.';
    return;
  }

  const attendance = attendanceStudents.map(s => {
    const selected = document.querySelector(`input[name="att_${s._id}"]:checked`);
    const notes = document.getElementById('notes_' + s._id)?.value || '';
    return {
      studentId: s._id,
      status: selected ? selected.value : '',
      notes: notes
    };
  });

  statusDiv.style.color = '#1B2A4A';
  statusDiv.textContent = 'Saving...';

  try {
    const response = await fetch('/.netlify/functions/mark-attendance', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + localStorage.getItem('adminToken')
      },
      body: JSON.stringify({ date, attendance })
    });

    const data = await response.json();

    if (data.success) {
      statusDiv.style.color = '#1E5631';
      statusDiv.textContent = `✅ Attendance saved for ${data.count} student(s)!`;
      loadAttendanceHistory();
    } else {
      statusDiv.style.color = '#dc3545';
      statusDiv.textContent = '❌ Error: ' + data.error;
    }
  } catch (error) {
    statusDiv.style.color = '#dc3545';
    statusDiv.textContent = '❌ Error: ' + error.message;
  }
}

async function loadAttendanceHistory() {
  try {
    const response = await fetch('/.netlify/functions/get-attendance');
    const data = await response.json();
    
    const container = document.getElementById('attendanceHistory');
    const records = data.records || [];

    if (records.length === 0) {
      container.innerHTML = '<p style="color: #666;">No attendance records yet.</p>';
      return;
    }

    const byDate = {};
    records.forEach(r => {
      if (!byDate[r.date]) byDate[r.date] = [];
      byDate[r.date].push(r);
    });

    const sortedDates = Object.keys(byDate).sort().reverse().slice(0, 10);

    container.innerHTML = sortedDates.map(date => {
      const dayRecords = byDate[date];
      const present = dayRecords.filter(r => r.status === 'present').length;
      const absent = dayRecords.filter(r => r.status === 'absent').length;
      const late = dayRecords.filter(r => r.status === 'late').length;
      
      return `
        <div style="background: white; border-radius: 8px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden;">
          <div style="background: #1B2A4A; color: white; padding: 10px 15px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <strong>${new Date(date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</strong>
            <span style="font-size: 0.85rem;">
              ✅ ${present} &nbsp; ❌ ${absent} &nbsp; ⏰ ${late}
            </span>
          </div>
        </div>
      `;
    }).join('');
  } catch (error) {
    console.error('Error loading history:', error);
  }
}

// Reload attendance when date changes
document.addEventListener('change', function(e) {
  if (e.target.id === 'attendanceDate') {
    loadAttendanceForm();
  }
});
</script>