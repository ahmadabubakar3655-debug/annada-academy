<script>
  document.getElementById('forgotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const messageDiv = document.getElementById('message');

    messageDiv.style.display = 'block';
    messageDiv.style.background = '#cce5ff';
    messageDiv.style.color = '#004085';
    messageDiv.textContent = 'Sending reset link...';

    try {
      const response = await fetch('/.netlify/functions/request-reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      const data = await response.json();
      console.log('Response:', data);

      if (data.success) {
        messageDiv.style.background = '#d4edda';
        messageDiv.style.color = '#155724';
        messageDiv.innerHTML = `
          ✅ <strong>Email sent!</strong><br>
          Please check your inbox (and spam folder) for the password reset link.
        `;
        document.getElementById('email').value = '';
      } else {
        messageDiv.style.background = '#f8d7da';
        messageDiv.style.color = '#721c24';
        messageDiv.innerHTML = '❌ <strong>Error:</strong> ' + (data.error || 'Request failed');
      }
    } catch (error) {
      console.error('Fetch error:', error);
      messageDiv.style.background = '#f8d7da';
      messageDiv.style.color = '#721c24';
      messageDiv.innerHTML = '❌ <strong>Fetch error:</strong> ' + error.message;
    }
  });
</script>