---
layout: base.njk
title: Reset Password
permalink: /reset-password/index.html
---

<div class="container" style="max-width: 450px; margin: 4rem auto; padding: 2rem; background: #F7F3EC; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
  <h1 style="color: #1B2A4A; text-align: center; font-size: 1.8rem; margin-bottom: 0.5rem;">Reset Password</h1>
  <p style="text-align: center; color: #666; margin-bottom: 2rem;">Enter your new password</p>

  <form id="resetForm">
    <div style="margin-bottom: 1.5rem;">
      <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #1B2A4A;">New Password</label>
      <input type="password" id="newPassword" required minlength="6" style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 1rem;">
    </div>
    <div style="margin-bottom: 1.5rem;">
      <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #1B2A4A;">Confirm Password</label>
      <input type="password" id="confirmPassword" required minlength="6" style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 1rem;">
    </div>
    <button type="submit" style="width: 100%; padding: 12px; background: #1E5631; color: white; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: background 0.3s;">
      Reset Password
    </button>
  </form>

  <div id="message" style="margin-top: 1rem; padding: 12px; border-radius: 8px; display: none;"></div>
</div>

<script>
  // Get token from URL
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token');

  if (!token) {
    document.getElementById('message').style.display = 'block';
    document.getElementById('message').style.background = '#f8d7da';
    document.getElementById('message').style.color = '#721c24';
    document.getElementById('message').textContent = 'No reset token found. Please request a new password reset.';
  }

  document.getElementById('resetForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const messageDiv = document.getElementById('message');

    if (newPassword !== confirmPassword) {
      messageDiv.style.display = 'block';
      messageDiv.style.background = '#f8d7da';
      messageDiv.style.color = '#721c24';
      messageDiv.textContent = 'Passwords do not match!';
      return;
    }

    if (!token) {
      messageDiv.style.display = 'block';
      messageDiv.style.background = '#f8d7da';
      messageDiv.style.color = '#721c24';
      messageDiv.textContent = 'No reset token found. Please request a new password reset.';
      return;
    }

    try {
      const response = await fetch('/.netlify/functions/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, newPassword })
      });

      const data = await response.json();

      if (data.success) {
        messageDiv.style.display = 'block';
        messageDiv.style.background = '#d4edda';
        messageDiv.style.color = '#155724';
        messageDiv.innerHTML = 'Password reset successful! Redirecting to login...';
        setTimeout(() => {
          window.location.href = '/student-login/';
        }, 3000);
      } else {
        messageDiv.style.display = 'block';
        messageDiv.style.background = '#f8d7da';
        messageDiv.style.color = '#721c24';
        messageDiv.textContent = data.error || 'Reset failed';
      }
    } catch (error) {
      messageDiv.style.display = 'block';
      messageDiv.style.background = '#f8d7da';
      messageDiv.style.color = '#721c24';
      messageDiv.textContent = 'An error occurred. Please try again.';
    }
  });
</script>