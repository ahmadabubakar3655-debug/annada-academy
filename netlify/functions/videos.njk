---
layout: base.njk
title: Videos
permalink: /videos/index.html
---

<section style="background: linear-gradient(135deg, #1B2A4A 0%, #2a3d6a 100%); padding: 4rem 1.5rem; text-align: center;">
  <div style="max-width: 800px; margin: 0 auto;">
    <h1 style="color: #FFFFFF; font-size: 2.75rem; font-weight: 700; margin: 0 0 1rem 0;">Video Gallery</h1>
    <div style="width: 80px; height: 3px; background: #C9A24B; margin: 0 auto 1.5rem auto;"></div>
    <p style="color: #F7F3EC; font-size: 1.15rem; opacity: 0.9;">
      Watch our students in action.
    </p>
  </div>
</section>

<section style="padding: 4rem 1.5rem; background: #FFFFFF;">
  <div style="max-width: 1100px; margin: 0 auto;">
    <div id="videosGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
      <p style="grid-column: 1/-1; text-align: center; color: #666;">Loading videos...</p>
    </div>
  </div>
</section>

<script>
  async function loadVideos() {
    try {
      const response = await fetch('/.netlify/functions/get-videos');
      const data = await response.json();
      
      const grid = document.getElementById('videosGrid');
      
      if (data.success && data.videos.length === 0) {
        grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #666;">No videos yet.</p>';
        return;
      }

      grid.innerHTML = data.videos.map(vid => `
        <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
          <video src="${vid.videoData}" controls style="width: 100%; height: 220px; object-fit: cover; background: #000;"></video>
          <div style="padding: 1rem;">
            <h3 style="margin: 0 0 0.5rem 0; color: #1B2A4A; font-size: 1.05rem;">${vid.title}</h3>
            ${vid.description ? `<p style="color: #666; font-size: 0.9rem; margin: 0;">${vid.description}</p>` : ''}
            <small style="color: #999; font-size: 0.8rem;">${new Date(vid.createdAt).toLocaleDateString()}</small>
          </div>
        </div>
      `).join('');
    } catch (error) {
      document.getElementById('videosGrid').innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #dc3545;">Error loading videos.</p>';
    }
  }
  loadVideos();
</script>